#include <winver.h>

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

1 ICON "SekaiDesk.ico"
1 24 "SekaiDesk.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     0,3,1,0
    PRODUCTVERSION  0,3,1,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SekaiDesk"
            VALUE "FileDescription",  "SekaiDesk"
            VALUE "FileVersion",      "0.3.1"
            VALUE "InternalName",     "SekaiDesk"
            VALUE "OriginalFilename", "SekaiDesk.exe"
            VALUE "ProductName",      "SekaiDesk"
            VALUE "ProductVersion",   "0.3.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
